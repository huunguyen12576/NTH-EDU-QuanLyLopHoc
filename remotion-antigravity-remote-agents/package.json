{
  "name": "antigravity-remote-agents",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion short film: Bếp vẫn đỏ lửa — Google Antigravity Remote Agents (9:16, 1080x1920, 30fps)",
  "scripts": {
    "studio": "remotion studio",
    "timeline": "python3 scripts/build_timeline.py",
    "audio": "python3 audio/make_audio.py",
