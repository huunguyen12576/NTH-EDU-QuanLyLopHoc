    "build": "npm run timeline && npm run audio && npm run render"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif-display": "^5.3.0",
    "@remotion/cli": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
