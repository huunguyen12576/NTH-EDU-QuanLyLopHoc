{
  "name": "cua-va-cua-so",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion short film: Cánh cửa & Cửa sổ — Bố mẹ nghiêm khắc vs Bố mẹ dễ tính (9:16, 1080x1920, 30fps)",
  "scripts": {
    "studio": "remotion studio",
    "audio": "tsx scripts/export-events.ts && python3 audio/make_audio.py",
    "render": "remotion render CuaVaCuaSo out/cua-va-cua-so.mp4 --codec=h264 --crf=16 --audio-bitrate=320k",
    "build": "npm run audio && npm run render"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
