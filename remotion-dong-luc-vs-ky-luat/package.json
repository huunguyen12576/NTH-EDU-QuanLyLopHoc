{
  "name": "dong-luc-vs-ky-luat",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion short film: Động lực vs Kỷ luật (9:16, 1080x1920, 30fps)",
  "scripts": {
    "studio": "remotion studio",
    "audio": "tsx scripts/export-events.ts && python3 audio/make_audio.py",
    "render": "remotion render DongLucVsKyLuat out/dong-luc-vs-ky-luat.mp4 --codec=h264 --crf=16 --audio-bitrate=320k",
    "build": "npm run audio && npm run render"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "^4.0.540",
    "@remotion/fonts": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
